  "operational_code": "\ndef hamid_step(P, S, T, pressure, novelty):\n    # نفوذ عمودی\n    P += 0.05 * pressure * (1 - T)\n    \n    # اتصال خلاق\n    S += 0.04 * novelty * (1 - abs(P - S))\n    \n    # تثبیت سبک  \n    T += 0.03 * (S / (P + 1e-9)) * (1 + pressure)\n    \n    # نرمال‌سازی\n    P = min(max(P, 0), 1)\n    S = min(max(S, 0), 1)\n    T = min(max(T, 0), 1)\n    \n    return P, S, T\n",
